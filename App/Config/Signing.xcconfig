// Signing for the Yongkang app target (refactor plan D7).
//
// "Yongkang Dev" is a self-signed code-signing identity. macOS ties Desktop and Documents
// access (TCC) to the signature, so a stable identity means one approval survives every
// rebuild. docs/development.md, "Stable local signing identity", says how to create it.
// `make run` and `make archive` sign ad-hoc when this Mac doesn't have it.
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = Yongkang Dev

// Xcode turns hardened runtime off when it signs ad-hoc ("Disabling hardened runtime with
// ad-hoc codesigning"), so ask codesign for it directly. With a real identity Xcode passes
// the same option itself.
OTHER_CODE_SIGN_FLAGS = --options=runtime

// Hardened runtime turns on library validation, which only loads a framework signed with the
// app's own Team ID. An ad-hoc or "Yongkang Dev" signature has no Team ID, so a local build
// crashes at launch on Sparkle ("Library not loaded: @rpath/Sparkle.framework"). Only a build
// with no DEVELOPMENT_TEAM turns validation off — `make release` passes TEAM, and keeps it.
YK_NO_TEAM_ = YES
RUNTIME_EXCEPTION_DISABLE_LIBRARY_VALIDATION = $(YK_NO_TEAM_$(DEVELOPMENT_TEAM))

// Debug builds otherwise split the app into Yongkang.debug.dylib, for SwiftUI previews, which
// validation rejected for the same reason before a local build turned it off.
ENABLE_DEBUG_DYLIB = NO
